# TTS Provider: 'edge' (mặc định miễn phí), 'elevenlabs', 'viettel'
TTS_PROVIDER=edge

# Default Edge TTS settings
DEFAULT_VOICE=vi-VN-NamMinhNeural
# Các giọng tiếng Việt hỗ trợ: vi-VN-NamMinhNeural (Nam), vi-VN-HoaiMyNeural (Nữ)
DEFAULT_SPEED=+10%

# Cấu hình API ngoài (nếu dùng ElevenLabs hoặc Viettel AI trong tương lai)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VIETTEL_API_KEY=
VIETTEL_VOICE_CODE=

